URL_API='https://admin.floy.com.ua/apisite/'
URL_STORAGE='https://admin.floy.com.ua/storage/'

# Файл спільний для всіх сайтів рушія (FLOY і копії: SMARKET…). Усе, чим сайти відрізняються, — у brand/:
# адреса (SITE_URL) і лічильники — brand/site.config.ts (url, analytics); процес PM2, порт (і порт dev), копії,
# кеш nginx — brand/server.env. Перекрити на час збірки можна тут: SITE_URL, GA4_ID / GTM_ID / META_PIXEL_ID
# (порожнє — вимкнено), порт dev — NUXT_PORT. Лічильники на сервері без перезбірки — змінними
# NUXT_PUBLIC_ANALYTICS_GA4 / _GTM / _METAPIXEL перед стартом процесу.
# ANALYTICS_DEV='1'   # рахувати й у dev-режимі (за замовчуванням лічильники локально мовчать)

# URL_API='http://localhost:8000/apisite/'
# URL_STORAGE='http://localhost:8000/storage/'
