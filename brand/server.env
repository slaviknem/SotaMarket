# Сервер сайту FLOY (floy.com.ua) — профіль цієї копії рушія. Читають deploy.sh (bash),
# ecosystem.config.cjs (PM2) і nuxt.config.ts (порт dev). Формат — KEY=value без пробілів і лапок.
# Змінювати лише в репозиторії (commit → push → bash deploy.sh): правка на сервері зламає git pull у deploy.sh.
# Після зміни APP, PORT чи WORKERS — pm2 delete + pm2 start ecosystem.config.cjs (restart їх не бачить; DEPLOY.md).

APP=floy-prod                      # процес PM2; тека на сервері — /root/nodeapps/FLOY-PROD
PORT=3000                          # порт Node (той самий — у шаблоні nginx node.stpl) і dev
WORKERS=4                          # копій Node (форкає cluster.mjs, не PM2); 1 — без форків
NGINX_CACHE=/var/cache/nginx-floy  # кеш nginx домену — deploy.sh чистить після рестарту
