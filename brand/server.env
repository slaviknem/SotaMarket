# Сервер сайту SotaMARKET (sotamarket.com.ua) — профіль цієї копії рушія. Читають deploy.sh (bash),
# ecosystem.config.cjs (PM2) і nuxt.config.ts (порт dev). Формат — KEY=value без пробілів і лапок.
# Змінювати лише в репозиторії (commit → push → bash deploy.sh): правка на сервері зламає git pull у deploy.sh.
# Після зміни APP, PORT чи WORKERS — pm2 delete + pm2 start ecosystem.config.cjs (restart їх не бачить; DEPLOY.md).

APP=SOTAMARKET                           # процес PM2; тека на сервері — /root/nodeapps/SOTAMARKET
PORT=3011                                # порт Node (той самий — у шаблоні nginx sotamarket.stpl) і dev; 3000–3003, 3010, 4000/4001, 9999 зайняті
WORKERS=2                                # копій Node (форкає cluster.mjs, не PM2): пам'ять сервера (PLAN-SITE-SOTAMARKET §8)
NGINX_CACHE=/var/cache/nginx-sotamarket  # кеш nginx домену — deploy.sh чистить після рестарту
